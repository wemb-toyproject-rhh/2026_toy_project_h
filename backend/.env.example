# 이 파일을 복사해서 .env 를 만들고 실제 값을 채워주세요.
#   copy .env.example .env
# .env 는 Git에 커밋되지 않습니다(.gitignore 등록됨). 실제 비밀번호를 이 파일에 적지 마세요.

# Backend server
PORT=4000

# RENOBIT 시뮬레이션 DB (tb_page_hist / tb_instance_hist / tb_user / tb_user_rhh / tb_project_list)
DB_HOST=
DB_PORT=5434
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# RHH 로그인 토큰(JWT) 서명용 시크릿. 랜덤 문자열로 채워주세요.
#   예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
