# Backend server
PORT=4000

# 현재(임시): RENOBIT 시뮬레이션 DB에 직접 연결합니다 (tb_page_hist / tb_instance_hist / tb_user).
DB_HOST=
DB_PORT=5434
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- 아래는 원래 계획했던 방향입니다. 지금은 미사용 (추후 과제) ---
# RHH's own Postgres DB (users/projects/history_entries/...) — NOT the customer's RENOBIT DB
# DATABASE_URL=postgres://user:password@localhost:5432/rhh

# Auth — 지금은 미구현
# JWT_SECRET=changeme
